
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // AUTHENTICATION HELPERS
    // ==========================================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.admin == true;
    }


    // ==========================================
    // STUDENT & PARENT VALIDATION
    // ==========================================

    function validPublicUser(uid) {
      return isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['student', 'parent']
        && request.resource.data.isActive == true
        && request.resource.data.keys().hasOnly([
          'uid',
          'name',
          'email',
          'role',
          'createdAt',
          'isActive'
        ]);
    }


    // ==========================================
    // USERS COLLECTION
    // ==========================================

    match /users/{uid} {

      // Owner can read own profile.
      // Admin can read all profiles.
      allow read: if isOwner(uid) || isAdmin();

      // Student / Parent self-registration
      // Driver profile creation by Admin only
      allow create: if validPublicUser(uid)
        || (
          isAdmin()
          && request.resource.data.uid == uid
          && request.resource.data.role == 'driver'
          && request.resource.data.isActive == true
          && request.resource.data.keys().hasOnly([
            'uid',
            'name',
            'email',
            'role',
            'mobile',
            'employeeId',
            'busNumber',
            'createdAt',
            'approvedAt',
            'isActive'
          ])
        );

      // Profile updates and deletion disabled
      allow update, delete: if false;
    }


    // ==========================================
    // DRIVER REGISTRATION REQUESTS
    // ==========================================

    match /driver_requests/{uid} {

      // Driver can read own request.
      // Admin can read all requests.
      allow read: if isOwner(uid) || isAdmin();

      // Driver submits registration request
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly([
          'uid',
          'name',
          'email',
          'mobile',
          'employeeId',
          'busNumber',
          'status',
          'createdAt'
        ]);

      // Only Admin can approve or reject
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'status',
            'reviewedAt',
            'reviewedBy'
          ])
        && request.resource.data.status in [
          'approved',
          'rejected'
        ]
        && request.resource.data.reviewedBy == request.auth.uid;

      // No deletion allowed
      allow delete: if false;
    }


    // ==========================================
    // BUSES COLLECTION
    // ==========================================

    match /buses/{id} {

      // Only Admin can read buses
      allow read: if isAdmin();

      // Only Admin can add buses
      allow create: if isAdmin();

      // Only Admin can edit buses
      allow update: if isAdmin();

      // Only Admin can delete buses
      allow delete: if isAdmin();
    }


    // ==========================================
    // BUS HISTORY COLLECTION
    // ==========================================

    match /bus_history/{id} {

      // Only Admin can read history
      allow read: if isAdmin();

      // Only Admin can create history records
      allow create: if isAdmin();

      // History cannot be modified or deleted
      allow update, delete: if false;
    }


    // ==========================================
    // ROUTES COLLECTION
    // ==========================================

    match /routes/{id} {
      allow read, write: if false;
    }


    // ==========================================
    // TRIPS COLLECTION
    // ==========================================

    match /trips/{id} {
      allow read, write: if false;
    }


    // ==========================================
    // ATTENDANCE COLLECTION
    // ==========================================

    match /attendance/{id} {
      allow read, write: if false;
    }


    // ==========================================
    // MAINTENANCE COLLECTION
    // ==========================================

    match /maintenance/{id} {
      allow read, write: if false;
    }


    // ==========================================
    // NOTIFICATIONS COLLECTION
    // ==========================================

    match /notifications/{id} {
      allow read, write: if false;
    }


    // ==========================================
    // SOS ALERTS COLLECTION
    // ==========================================

    match /sos_alerts/{id} {
      allow read, write: if false;
    }

  }
}
