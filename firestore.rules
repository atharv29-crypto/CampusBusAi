
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.admin == true;
    }

    match /users/{uid} {
      // Users can read their own profile.
      // Verified admins can read user profiles for the dashboard.
      allow read: if isOwner(uid) || isAdmin();

      // Public registration is restricted to Student and Parent.
      allow create: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['student', 'parent']
        && request.resource.data.isActive == true
        && request.resource.data.keys().hasOnly([
          'uid',
          'name',
          'email',
          'role',
          'createdAt',
          'isActive'
        ]);

      // Profile changes and deletions are not allowed from the client.
      allow update, delete: if false;
    }

    // These collections remain blocked until secure rules are added.
    match /trips/{tripId} {
      allow read, write: if false;
    }

    match /sos_alerts/{alertId} {
      allow read, write: if false;
    }
  }
}
