rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isAssignedDriver(busId) {
      return signedIn()
        && exists(/databases/$(database)/documents/buses/$(busId))
        && get(/databases/$(database)/documents/buses/$(busId)).data.driverId == request.auth.uid;
    }
    function ownsTrip(tripId) {
      return exists(/databases/$(database)/documents/trips/$(tripId))
        && get(/databases/$(database)/documents/trips/$(tripId)).data.driverId == request.auth.uid;
    }

    match /users/{uid} {
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['student', 'parent']
        && request.resource.data.isActive == true
        && (request.resource.data.role != 'student' || (request.resource.data.busId is string
          && exists(/databases/$(database)/documents/buses/$(request.resource.data.busId))
          && get(/databases/$(database)/documents/buses/$(request.resource.data.busId)).data.isActive == true))
        && request.resource.data.keys().hasOnly([
          'uid','name','email','role','createdAt','isActive',
          'studentId','studentBusId','busId','busNumber','requestedStudentBusId','parentLinkStatus','relationship'
        ]);
      allow read: if isOwner(uid) || isAdmin()
        || (signedIn() && resource.data.role == 'student'
            && resource.data.busId is string && isAssignedDriver(resource.data.busId))
        || (signedIn() && resource.data.role == 'student'
            && resource.data.approvedParentUids is list
            && resource.data.approvedParentUids.hasAny([request.auth.uid]));
      allow update: if isAdmin()
        || (isOwner(uid) && resource.data.role == 'student'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvedParentUids','updatedAt'])
            && request.resource.data.approvedParentUids is list);
      allow delete: if isAdmin();
    }

    match /driver_requests/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending';
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt','reviewedBy'])
        && request.resource.data.status in ['approved','rejected'];
      allow delete: if false;
    }

    match /buses/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.isActive == true) || (signedIn() && resource.data.driverId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /bus_history/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /routes/{id} {
      allow read: if isAdmin() || signedIn();
      allow write: if isAdmin();
    }

    match /trips/{id} {
      allow get: if isAdmin() || (signedIn() && (resource == null || resource.data.driverId == request.auth.uid));
      allow list: if isAdmin() || (signedIn() && resource.data.driverId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.driverId == request.auth.uid
        && isAssignedDriver(request.resource.data.busId)
        && request.resource.data.status == 'inProgress';
      allow update: if isAdmin() || (signedIn() && resource.data.driverId == request.auth.uid
        && request.resource.data.driverId == resource.data.driverId
        && request.resource.data.busId == resource.data.busId
        && request.resource.data.status == 'completed');
      allow delete: if isAdmin();
    }

    match /attendance/{id} {
      allow get: if isAdmin() || (signedIn() && (resource == null ||
        (resource.data.driverId == request.auth.uid && isAssignedDriver(resource.data.busId))));
      allow list: if isAdmin() || (signedIn() && resource.data.driverId == request.auth.uid
        && isAssignedDriver(resource.data.busId));
      allow create: if signedIn()
        && request.resource.data.driverId == request.auth.uid
        && isAssignedDriver(request.resource.data.busId)
        && ownsTrip(request.resource.data.tripId)
        && request.resource.data.status == 'boarded';
      allow update: if signedIn() && resource.data.driverId == request.auth.uid
        && isAssignedDriver(resource.data.busId)
        && ownsTrip(resource.data.tripId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','dropStop','droppedAt','updatedAt','dropMarkedByTripCompletion'
        ])
        && request.resource.data.status == 'dropped';
      allow delete: if isAdmin();
    }

    match /student_id_lookup/{studentId} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.studentId == studentId;
      allow update, delete: if false;
    }

    match /student_bus_id_lookup/{studentBusId} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.studentBusId == studentBusId;
      allow update, delete: if false;
    }

    match /parent_link_requests/{requestId} {
      allow create: if signedIn() && request.resource.data.parentUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if isAdmin() || (signedIn() &&
        (resource.data.parentUid == request.auth.uid || resource.data.studentUid == request.auth.uid));
      allow update: if signedIn() && resource.data.studentUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved','rejected'];
      allow delete: if isAdmin();
    }

    match /maintenance/{id} {
      allow read, write: if isAdmin();
    }
    match /notifications/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /sos_alerts/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.isActive == true) || (signedIn() && resource.data.driverId == request.auth.uid);
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }
  }
}
